# Used for Meta GET webhook verification. Generate a long random value.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-token

# Meta App Dashboard > App settings > Basic > App secret.
# Required to verify X-Hub-Signature-256 on every POST delivery.
META_APP_SECRET=replace-with-your-meta-app-secret

# Optional local server port.
PORT=8787

# Internal Vuva AI — Prospecting area (private dashboard at /internal).
# Both must be set (as Worker secrets in production) or /internal fails closed (503).
# Set with: npx wrangler secret put INTERNAL_AUTH_USER / INTERNAL_AUTH_PASS
INTERNAL_AUTH_USER=
INTERNAL_AUTH_PASS=

# Vuva AI Prospecting — integrations for the internal dashboard.
# Tavily web search (https://tavily.com) — powers company discovery.
TAVILY_API_KEY=

# WhatsApp Business Cloud API — powers outbound outreach.
# A permanent access token + the phone-number-id of the sender number.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

